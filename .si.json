{
  "plugin": "org.smartide.plugin.python",
  "run": "python ytBro.py",
  "gui": true,
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".py": {
      "enabled": true,
      "run": "pylsp"
    },
    ".yml": {
      "enabled": true,
      "run": "yaml-language-server --stdio"
    },
    ".xml": {
      "enabled": true,
      "run": "lemminx"
    },
    ".md": {
      "enabled": true,
      "run": "marksman server"
    }
  }
}